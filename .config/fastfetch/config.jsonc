{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/ascii.txt",
    "padding": {
        "top": 0,
        "left": 5,
        "right": 5
    },
    "color": {
        "1": "red",
        "2": "yellow"
    }
  },
  "display": {
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "break",
    "colors"
  ]
}
