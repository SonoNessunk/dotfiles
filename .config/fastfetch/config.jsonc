// Modified from: 24.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/.config/fastfetch/logo/ascii.txt",
      "padding": {
        //"top": 1,
        "left": 5,
        "right": 5
      },
      "color": {
        "1": "red",
        "2": "yellow"
      }
    },
    "display": {
      "separator": " ",
      "constants": [
        // CONSTANT {$1} - VERTICAL BARS AT START AND 75th CHARACTERS FORWARD AND BACKWARD
        "\u001b[80m│                                                            │\u001b[60D\u001b[80m"
      ]
    },
    "modules": [
      // CUSTOM - Top UI bar
      {
        "type": "custom",
        "key": "{#00}╭ Keys ───────╮",
        "format": "{#00}╭ Values ────────────────────────────────────────────────────╮",
      },
      {
        "type": "title",
        "key": "{#00}│ {#92}User        {#00}│",
        "format": "{$1}{user-name}  {#2}[{home-dir}]"
      },
      {
        "type": "users",
        "key": "{#00}│ {#92}Users       {#00}│",
        "myselfOnly": false,
        "format": "{$1}{1}@{host-name}{/host-name}localhost{/}{?client-ip}  {#2}[IP:{client-ip}]{?}  [Login time: {login-time}]"
      },

      {
        "type": "title",
        "key": "{#00}│ {#92}Host        {#00}│",
        "format": "{$1}{host-name}"
      },
      {
        "type": "host",
        "key": "{#00}│ {#93}Machine     {#00}│",
        "format": "{$1}{name}  {#2}{version}"
      },
      {
        "type": "os",
        "key": "{#00}│ {#93}OS          {#00}│",
        "format": "{$1}{?pretty-name}{pretty-name}{?}{/pretty-name}{name}{/} {codename}  {#2}[v{version}] [{arch}]"
      },
      {
        "type": "kernel",
        "key": "{#00}│ {#93}Kernel      {#00}│",
        "format": "{$1}{sysname}  {#2}[v{release}]"
      },
      {
        "type": "cpu",
        "key": "{#00}│ {#91}CPU         {#00}│",
        "showPeCoreCount": true,
        "temp": true,
        "format": "{$1}{name}  {#2}[C:{core-types}] [{freq-max}]"
      },
      {
        "type": "gpu",
        "key": "{#00}│ {#91}GPU         {#00}│",
        "detectionMethod": "auto",
        "driverSpecific": true,
        "format": "{$1}{name}  {#2}[C:{core-count}]{?frequency} [{frequency}]{?} {#2}[{type}]"
      },
      {
        "type": "memory",
        "key": "{#00}│ {#91}Memory      {#00}│",
        "format": "{$1}{used} / {total} ({percentage})"
      },
      //{
      //  "type": "disk",
      //  "key": "{#00}│ {#91}Disk        {#00}│",
      //  "format": "{$1}{size-used} / {size-total} ({size-percentage})"
      //},
      {
        "type": "poweradapter",
        "key": "{#00}│ {#91}Power       {#00}│",
        "format": "{$1}{name}"
      },
      {
        "type": "terminal",
        "key": "{#00}│ {#95}Terminal    {#00}│",
        "format": "{$1}{pretty-name}  {#2}[{version}] [PID:{pid}]"
      },
      {
        "type": "shell",
        "key": "{#00}│ {#95}Shell       {#00}│",
        "format": "{$1}{pretty-name}  {#2}[v{version}] [PID:{pid}]"
      },
      {
        // localip IPv4
        "type": "localip",
        "key": "{#00}│ {#94}Local IPv4  {#00}│",
        "showPrefixLen": true,
        "showIpv4": true,
        "showIpv6": false,
        "showMtu": true,
        "format": "{$1}{ifname}: {ipv4}  {#2}[MTU:{mtu}]"
      },
      {
        // localip IPv6
        "type": "localip",
        "key": "{#00}│ {#94}Local IPv6  {#00}│",
        "showPrefixLen": true,
        "showIpv4": false,
        "showIpv6": true,
        "showMtu": true,
        "format": "{$1}{ifname}: {ipv6}  {#2}[MTU:{mtu}]"
      },
      {
        "type": "publicip",
        "key": "{#00}│ {#94}Public IPv4 {#00}│",
        "ipv6": false,
        "format": "{$1}{ip}  {#2}[{location}]"
      },
      {
        "type": "publicip",
        "key": "{#00}│ {#94}Public IPv6 {#00}│",
        "ipv6": true,
        "format": "{$1}{ip}  {#2}[{location}]"
      },
      // CUSTOM - Button UI bar
      {
        "type": "custom",
        "key": "{#00}╰─────────────╯",
        "format": "{#00}╰────────────────────────────────────────────────────────────╯",
      },
      "break",
      {
        "type": "custom",
        "key": " ",
        "format": "{#00}╭ Colors ──────────────────────────╮",
      },
      {
        "type": "custom",
        "format": "{#00}│ {#40}    {#41}    {#42}    {#43}    {#44}    {#45}    {#46}    {#47}    {#}{#00} │",
      },
      {
        "type": "custom",
        "format": "{#00}│ {#100}    {#101}    {#102}    {#103}    {#104}    {#105}    {#106}    {#107}    {#}{#00} │",
      },
      {
        "type": "custom",
        "format": "{#00}╰──────────────────────────────────╯",
      },
    ]
  }
