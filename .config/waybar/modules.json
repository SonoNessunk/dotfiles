 {
    "custom/arch": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "btw"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
        }
    },

    "tray": {
        "spacing": 10,
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "default": [" ", " ", " "]
        },
        "on-click": "pkill pavucontrol || pavucontrol"
    },

    "network": {
        "format-wifi": "   {essid} ({signalStrength}%)",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected 󰈂",
      	"on-click": "pkill nm-connection-e || nm-connection-editor"
    },

    "hyprland/language": {
        "icon-size": 20,
        "format": "  {}",
        "format-it": "IT",
        "format-en": "EN"
    },

    "clock": {
        "timezone": "Europe/Rome",
        "format": "{:%H:%M | %e %B} ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        }
}
